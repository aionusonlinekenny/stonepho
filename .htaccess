# Stone Pho Website - Apache Configuration
# Hosting: Debian + PHP 7.4.10
# Document Root: /home/users/web/b1405/dom.kennylucia51612/public_html

RewriteEngine On

# Force HTTPS redirect - must be at top
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Set default index files
DirectoryIndex index.html index.php

# PHP Configuration for uploads
php_value upload_max_filesize 10M
php_value post_max_size 12M
php_value max_execution_time 300
php_value memory_limit 256M
php_value max_input_time 300
php_value max_input_vars 3000

# Enable file uploads
php_flag file_uploads On

# CORS headers - set early to ensure they apply
<IfModule mod_headers.c>
    # CORS for PHP API endpoints
    <FilesMatch "\.php$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
        Header set Access-Control-Max-Age "3600"
    </FilesMatch>

    # Security headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Handle preflight OPTIONS requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Allow uploads directory access
<Directory "uploads">
    Options -Indexes
    AllowOverride None
    Order Allow,Deny
    Allow from all

    # Only allow image files in uploads
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
        Order Allow,Deny
        Allow from all
    </FilesMatch>

    # Block PHP execution in uploads directory
    <FilesMatch "\.php$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>
</Directory>

# API directory configuration
<Directory "api">
    Options -Indexes
    AllowOverride None
    Order Allow,Deny
    Allow from all

    # Allow PHP files in API directory
    <FilesMatch "\.php$">
        Order Allow,Deny
        Allow from all
    </FilesMatch>
</Directory>

# Compression for better performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On

    # Images
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"

    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # HTML
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Handle React Router (SPA routing)
RewriteBase /
RewriteRule ^index\.html$ - [L]

# Don't rewrite files and directories that exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Don't rewrite API calls
RewriteCond %{REQUEST_URI} !^/api/

# Don't rewrite uploads
RewriteCond %{REQUEST_URI} !^/uploads/

# Don't rewrite PHP files
RewriteCond %{REQUEST_URI} !\.php$

# Redirect everything else to index.html for React Router
RewriteRule . /index.html [L]

# Block access to sensitive files
<FilesMatch "^(\.htaccess|\.htpasswd|\.env|package\.json|package-lock\.json|\.git)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to backup files
<FilesMatch "\.(bak|backup|old|tmp|log|sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Custom error pages
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html

# Prevent hotlinking of images
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?stonephovaldosta\.com [NC]
RewriteCond %{REQUEST_URI} \.(jpg|jpeg|png|gif|webp)$ [NC]
RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [F]
