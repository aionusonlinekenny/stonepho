# Stone Pho Website - Apache Configuration
# Hosting: Debian + PHP 7.4.10
# Document Root: /home/users/web/b1405/dom.kennylucia51612/public_html

RewriteEngine On

# Force HTTPS redirect - must be first
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Set default index files
DirectoryIndex index.html index.php

# PHP Configuration for uploads
php_value upload_max_filesize 10M
php_value post_max_size 12M
php_value max_execution_time 300
php_value memory_limit 256M
php_value max_input_time 300
php_value max_input_vars 3000
php_flag file_uploads On

# CORS and Security Headers - SINGLE BLOCK
<IfModule mod_headers.c>
    # Remove any existing CSP that might block uploads
    Header always unset Content-Security-Policy
    Header always unset X-Content-Security-Policy
    Header always unset X-WebKit-CSP

    # CORS headers - allow cross-origin for uploads
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header always set Access-Control-Max-Age "3600"

    # Security headers (not too strict)
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Handle preflight OPTIONS requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Disable caching for specific PHP files
<Files "versions.php">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
</Files>

# Allow uploads directory access
<Directory "uploads">
    Options -Indexes
    AllowOverride None
    Order Allow,Deny
    Allow from all

    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
        Order Allow,Deny
        Allow from all
    </FilesMatch>

    # Block PHP execution in uploads
    <FilesMatch "\.php$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>
</Directory>

# API directory configuration
<Directory "api">
    Options -Indexes
    AllowOverride None
    Order Allow,Deny
    Allow from all

    <FilesMatch "\.php$">
        Order Allow,Deny
        Allow from all
    </FilesMatch>
</Directory>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# React Router (SPA routing)
RewriteBase /
RewriteRule ^index\.html$ - [L]

# Don't rewrite existing files/directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/uploads/
RewriteCond %{REQUEST_URI} !\.php$

# Send everything else to index.html
RewriteRule . /index.html [L]

# Block sensitive files
<FilesMatch "^(\.htaccess|\.htpasswd|\.env|package\.json|package-lock\.json|\.git)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block backup files
<FilesMatch "\.(bak|backup|old|tmp|temp|log|sql|gz|tar|zip)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Custom error pages
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html

# Prevent hotlinking
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?stonephovaldosta\.com [NC]
RewriteCond %{REQUEST_URI} \.(jpg|jpeg|png|gif|webp)$ [NC]
RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [F]
